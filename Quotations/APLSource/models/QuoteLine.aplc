:Class QuoteLine
    ⍝ linePence: int, required
    ⍝ name: str, required
    ⍝ productId: str, required
    ⍝ quantity: int, required
    ⍝ unitPricePence: int, required

    :Property linePence
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_linePence' (⊂'null')
        ∇
        ∇ Set args
            _linePence←args.NewValue
        ∇
    :EndProperty

    :Property name
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_name' (⊂'null')
        ∇
        ∇ Set args
            _name←args.NewValue
        ∇
    :EndProperty

    :Property productId
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_productId' (⊂'null')
        ∇
        ∇ Set args
            _productId←args.NewValue
        ∇
    :EndProperty

    :Property quantity
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_quantity' (⊂'null')
        ∇
        ∇ Set args
            _quantity←args.NewValue
        ∇
    :EndProperty

    :Property unitPricePence
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_unitPricePence' (⊂'null')
        ∇
        ∇ Set args
            _unitPricePence←args.NewValue
        ∇
    :EndProperty

    ∇ make0
        :Access public
        :Implements constructor
    ∇

    ∇ make1 args
        :Access public
        :Implements constructor
        ⍝ Validate required fields (readOnly fields are server-generated, not required from caller)
        missing←'linePence' 'name' 'productId' 'quantity' 'unitPricePence'~args.⎕NL ¯2
        :If 0<⍴missing
            ⎕SIGNAL ⊂('EN' 11)('Message'('Missing required fields: ',1↓∊(⊂', '),¨missing))
        :EndIf
        ⍝ Set properties through their setters
        :If 2=args.⎕NC 'linePence' ⋄ linePence←args.linePence ⋄ :EndIf
        :If 2=args.⎕NC 'name' ⋄ name←args.name ⋄ :EndIf
        :If 2=args.⎕NC 'productId' ⋄ productId←args.productId ⋄ :EndIf
        :If 2=args.⎕NC 'quantity' ⋄ quantity←args.quantity ⋄ :EndIf
        :If 2=args.⎕NC 'unitPricePence' ⋄ unitPricePence←args.unitPricePence ⋄ :EndIf
    ∇

    ∇ build←FormatNS
        :Access public
        build←⎕NS ''
        :If 2=⎕NC '_linePence'
            build.linePence←linePence
        :EndIf
        :If 2=⎕NC '_name'
            build.name←name
        :EndIf
        :If 2=⎕NC '_productId'
            build.productId←productId
        :EndIf
        :If 2=⎕NC '_quantity'
            build.quantity←quantity
        :EndIf
        :If 2=⎕NC '_unitPricePence'
            build.unitPricePence←unitPricePence
        :EndIf
    ∇

    ∇ inst←FromResponse ns
        :Access public
        inst←⎕THIS
        :If 0<ns.⎕NC 'linePence' ⋄ inst._linePence←ns.linePence ⋄ :EndIf
        :If 0<ns.⎕NC 'name' ⋄ inst._name←ns.name ⋄ :EndIf
        :If 0<ns.⎕NC 'productId' ⋄ inst._productId←ns.productId ⋄ :EndIf
        :If 0<ns.⎕NC 'quantity' ⋄ inst._quantity←ns.quantity ⋄ :EndIf
        :If 0<ns.⎕NC 'unitPricePence' ⋄ inst._unitPricePence←ns.unitPricePence ⋄ :EndIf
    ∇
:EndClass
