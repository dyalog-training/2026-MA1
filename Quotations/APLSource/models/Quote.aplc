:Class Quote
    ⍝ id: int, required
    ⍝ items: array[quoteLine], required, REFERENCE
    ⍝ reference: str, required
    ⍝ totalPence: int, required

    :Property id
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_id' (⊂'null')
        ∇
        ∇ Set args
            _id←args.NewValue
        ∇
    :EndProperty

    :Property items
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_items' (⊂'null')
        ∇
        ∇ Set args
            _items←args.NewValue
        ∇
    :EndProperty

    :Property reference
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_reference' (⊂'null')
        ∇
        ∇ Set args
            _reference←args.NewValue
        ∇
    :EndProperty

    :Property totalPence
        :Access public
        ∇ r←Get
            r←⎕VGET ⊂'_totalPence' (⊂'null')
        ∇
        ∇ Set args
            _totalPence←args.NewValue
        ∇
    :EndProperty

    ∇ make0
        :Access public
        :Implements constructor
    ∇

    ∇ make1 args
        :Access public
        :Implements constructor
        ⍝ Validate required fields (readOnly fields are server-generated, not required from caller)
        missing←'id' 'items' 'reference' 'totalPence'~args.⎕NL ¯2
        :If 0<⍴missing
            ⎕SIGNAL ⊂('EN' 11)('Message'('Missing required fields: ',1↓∊(⊂', '),¨missing))
        :EndIf
        ⍝ Set properties through their setters
        :If 2=args.⎕NC 'id' ⋄ id←args.id ⋄ :EndIf
        :If 2=args.⎕NC 'items' ⋄ items←args.items ⋄ :EndIf
        :If 2=args.⎕NC 'reference' ⋄ reference←args.reference ⋄ :EndIf
        :If 2=args.⎕NC 'totalPence' ⋄ totalPence←args.totalPence ⋄ :EndIf
    ∇

    ∇ build←FormatNS
        :Access public
        build←⎕NS ''
        :If 2=⎕NC '_id'
            build.id←id
        :EndIf
        :If 2=⎕NC '_items'
            :If 0∊⍴items
                build.items←⍬
            :Else
                build.items←1∘/items.FormatNS
            :EndIf
        :EndIf
        :If 2=⎕NC '_reference'
            build.reference←reference
        :EndIf
        :If 2=⎕NC '_totalPence'
            build.totalPence←totalPence
        :EndIf
    ∇

    ∇ inst←FromResponse ns
        :Access public
        inst←⎕THIS
        :If 0<ns.⎕NC 'id' ⋄ inst._id←ns.id ⋄ :EndIf
        :If 2=ns.⎕NC 'items'
            :If 0∊⍴ns.items
                inst._items←⍬
            :Else
                inst._items←{(⎕NEW (⊃⊃⎕CLASS ⎕THIS).##.QuoteLine).FromResponse ⍵}¨ns.items
            :EndIf
        :EndIf
        :If 0<ns.⎕NC 'reference' ⋄ inst._reference←ns.reference ⋄ :EndIf
        :If 0<ns.⎕NC 'totalPence' ⋄ inst._totalPence←ns.totalPence ⋄ :EndIf
    ∇
:EndClass
