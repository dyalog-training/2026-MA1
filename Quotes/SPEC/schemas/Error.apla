(
    type:'object'
    required:'code' 'message'
    properties:(
        code:(type:'string')
        message:(type:'string' ⋄ description:'Says how to fix the request where possible')
        field:(type:'string' ⋄ description:'Path of the offending input, e.g. items[1].quantity')
    )
    example:(
        code:'INVALID_QUANTITY'
        field:'items[1].quantity'
        message:'Quantity must be a positive integer; omit the item to remove it from the quotation.'
    )
)
